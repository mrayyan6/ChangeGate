{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AuditRecord.schema.json",
  "additionalProperties": false,
  "properties": {
    "seq": {
      "title": "Seq",
      "type": "integer"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "sim_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sim Time"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "arm": {
      "title": "Arm",
      "type": "string"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "event": {
      "enum": [
        "run_start",
        "decision",
        "approval",
        "apply",
        "run_end"
      ],
      "title": "Event",
      "type": "string"
    },
    "action": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action"
    },
    "input_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Digest"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "prev_hash": {
      "title": "Prev Hash",
      "type": "string"
    },
    "hash": {
      "title": "Hash",
      "type": "string"
    }
  },
  "required": [
    "seq",
    "timestamp",
    "run_id",
    "arm",
    "event",
    "prev_hash",
    "hash"
  ],
  "title": "AuditRecord",
  "type": "object"
}
