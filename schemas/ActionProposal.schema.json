{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ActionProposal.schema.json",
  "additionalProperties": false,
  "description": "A tool call the agent wants to make, captured before the PEP decides.",
  "properties": {
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "step": {
      "title": "Step",
      "type": "integer"
    },
    "tool": {
      "title": "Tool",
      "type": "string"
    },
    "args": {
      "additionalProperties": true,
      "title": "Args",
      "type": "object"
    },
    "proposed_by": {
      "default": "changegate-agent",
      "title": "Proposed By",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "step",
    "tool"
  ],
  "title": "ActionProposal",
  "type": "object"
}
