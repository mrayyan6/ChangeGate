{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PolicyDecision.schema.json",
  "$defs": {
    "Reason": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "policy": {
          "title": "Policy",
          "type": "string"
        },
        "effect": {
          "enum": [
            "deny",
            "require_approval"
          ],
          "title": "Effect",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "severity": {
          "default": "high",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "resource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource"
        }
      },
      "required": [
        "rule_id",
        "policy",
        "effect",
        "message"
      ],
      "title": "Reason",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": [
        "allow",
        "deny",
        "require_approval"
      ],
      "title": "Decision",
      "type": "string"
    },
    "reasons": {
      "items": {
        "$ref": "#/$defs/Reason"
      },
      "title": "Reasons",
      "type": "array"
    },
    "guard": {
      "description": "none, opa, trivy, agentspec or fail_closed",
      "title": "Guard",
      "type": "string"
    },
    "latency_ms": {
      "default": 0.0,
      "title": "Latency Ms",
      "type": "number"
    },
    "bundle_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bundle Digest"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "decision",
    "guard"
  ],
  "title": "PolicyDecision",
  "type": "object"
}
